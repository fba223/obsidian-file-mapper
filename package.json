{
  "name": "file-mapper-plugin",
  "version": "1.0.0",
  "description": "Map local files to Obsidian with custom YAML frontmatter",
  "main": "main.js",
  "scripts": {
    "build": "esbuild main.ts --bundle --outfile=main.js --target=es2016 --format=cjs --external:obsidian --external:electron --external:fs --external:path",
    "dev": "esbuild main.ts --bundle --outfile=main.js --target=es2016 --format=cjs --external:obsidian --external:electron --external:fs --external:path --watch",
    "test": "node tests/run.js",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": ["obsidian", "obsidian-plugin", "file-mapper"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.27.3",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "obsidian": "^1.4.0"
  }
}
