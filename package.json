{
  "name": "file-mapper-plugin",
  "version": "1.0.0",
  "description": "Map local files to Obsidian with custom YAML frontmatter",
  "main": "main.js",
  "scripts": {
    "build": "esbuild main.ts --bundle --outfile=main.js --target=es2016 --format=cjs --external:obsidian --external:electron --external:fs --external:path --external:child_process --external:crypto",
    "dev": "esbuild main.ts --bundle --outfile=main.js --target=es2016 --format=cjs --external:obsidian --external:electron --external:fs --external:path --external:child_process --external:crypto --watch",
    "test": "node tests/run.js"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "file-mapper"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "obsidian": "^1.4.0"
  }
}
